{
  "name": "figma2ae",
  "version": "1.0.0",
  "private": true,
  "description": "Figma → After Effects bridge: Figma plugin, embedded WebSocket bridge, and AE CEP panel + ExtendScript builder.",
  "license": "MIT",
  "author": "Jay Prajapati <tech@jaypr.io>",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "bridge-server",
    "figma-plugin",
    "ae-extension"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "dev:bridge": "npm run dev --workspace @f2ae/bridge-server",
    "clean": "rm -rf dist */dist"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "acorn": "8.19.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
